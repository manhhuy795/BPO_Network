# Địa chỉ Ubuntu VM mà Docker Desktop có thể truy cập.
UBUNTU_VM_IP=192.168.192.133
UBUNTU_SSH_USER=huy
UBUNTU_SSH_KEY=C:/Users/huy/.ssh/manhhuy

# PostgreSQL nội bộ cho dữ liệu dự án và n8n.
POSTGRES_DB=bpo_network
POSTGRES_USER=bpo_app
POSTGRES_PASSWORD=thay_bang_mat_khau_manh

# Khóa mã hóa và tài khoản quản trị n8n cục bộ.
N8N_ENCRYPTION_KEY=thay_bang_chuoi_ngau_nhien_it_nhat_32_ky_tu
N8N_OWNER_EMAIL=admin@bpo.local
N8N_OWNER_FIRST_NAME=Quan_tri
N8N_OWNER_LAST_NAME=BPO
N8N_OWNER_PASSWORD=thay_bang_mat_khau_n8n_manh

# Email: mặc định chỉ ghi log an toàn. Chuyển sang smtp sau khi điền tài khoản thật.
EMAIL_MODE=log
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=thay_bang_tai_khoan_smtp
SMTP_PASSWORD=thay_bang_mat_khau_smtp
SMTP_SECURE=false
SMTP_FROM=bpo-monitor@example.com
SMTP_TO=it@example.com

# GLPI và MySQL riêng. Không dùng chung database PostgreSQL nghiệp vụ.
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=thay_bang_mat_khau_database_glpi
GLPI_DB_ROOT_PASSWORD=thay_bang_mat_khau_root_mysql
GLPI_API_USER=glpi
GLPI_API_PASSWORD=thay_bang_mat_khau_quan_tri_glpi

# Grafana. Có thể bỏ GRAFANA_DB_PASSWORD để dùng giá trị POSTGRES_PASSWORD,
# nhưng nên đặt mật khẩu riêng khi triển khai ngoài phòng thí nghiệm.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=thay_bang_mat_khau_grafana_manh
GRAFANA_DB_USER=bpo_grafana
GRAFANA_DB_PASSWORD=thay_bang_mat_khau_chi_doc_postgresql
