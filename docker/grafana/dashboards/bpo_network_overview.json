    {
      "id": 15, "type": "timeseries", "title": "Lịch sử thời gian failover và failback", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "bpo-prometheus" },
      "targets": [
        { "expr": "bpo_failover_duration_seconds", "legendFormat": "Failover", "refId": "A" },
        { "expr": "bpo_failback_duration_seconds", "legendFormat": "Failback", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 16, "type": "table", "title": "Danh sách sự cố", "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "postgres", "uid": "bpo-postgres" },
      "targets": [{
        "format": "table", "rawQuery": true, "refId": "A",
        "rawSql": "SELECT i.id AS \"Mã\", i.title AS \"Sự cố\", CASE i.severity WHEN 'cao' THEN 'Cao' WHEN 'trung_binh' THEN 'Trung bình' ELSE 'Thấp' END AS \"Mức độ\", CASE i.status WHEN 'open' THEN 'Đang mở' ELSE 'Đã phục hồi' END AS \"Trạng thái\", i.suspected_cause AS \"Nguyên nhân nghi ngờ\", timezone('Asia/Ho_Chi_Minh', i.first_seen) AS \"Bắt đầu\", i.alert_count AS \"Số cảnh báo\", COALESCE(CASE x.glpi_status WHEN 'open' THEN 'Đang mở' WHEN 'closed' THEN 'Đã đóng' WHEN 'failed' THEN 'Lỗi đồng bộ' ELSE 'Đang chờ' END, 'Chưa tạo') AS \"Phiếu GLPI\", timezone('Asia/Ho_Chi_Minh', i.resolved_at) AS \"Phục hồi\" FROM incidents i LEFT JOIN incident_integrations x ON x.incident_id=i.id WHERE $__timeFilter(i.first_seen) ORDER BY CASE WHEN i.status='open' THEN 0 ELSE 1 END, i.severity='cao' DESC, i.last_seen DESC LIMIT 200;"
      }],
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false } }, "overrides": [] },
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true, "sortBy": [] }
    },
    {
      "id": 17, "type": "bargauge", "title": "Số sự cố theo loại", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 34 },
      "datasource": { "type": "postgres", "uid": "bpo-postgres" },
      "targets": [{ "format": "table", "rawQuery": true, "refId": "A", "rawSql": "SELECT CASE WHEN incident_key LIKE 'wan-quality:%' THEN 'Chất lượng WAN' WHEN incident_key LIKE 'wan-%' THEN 'Sự cố WAN' WHEN incident_key LIKE 'service-%' THEN 'Dịch vụ đối tác' WHEN incident_key='monitoring-exporter' THEN 'Hệ thống giám sát' ELSE 'Khác' END AS metric, count(*)::double precision AS value FROM incidents WHERE $__timeFilter(first_seen) GROUP BY 1 ORDER BY 2 DESC;" }],
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 3 }, { "color": "red", "value": 10 }] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "maxVizHeight": 300, "minVizHeight": 16, "minVizWidth": 8, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }, "showUnfilled": true, "sizing": "auto", "text": { "titleSize": 14, "valueSize": 14 }, "valueMode": "color" }
    },
    {
      "id": 18, "type": "bargauge", "title": "Số sự cố theo mức độ", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 34 },
      "datasource": { "type": "postgres", "uid": "bpo-postgres" },
      "targets": [{ "format": "table", "rawQuery": true, "refId": "A", "rawSql": "SELECT CASE severity WHEN 'cao' THEN 'Cao' WHEN 'trung_binh' THEN 'Trung bình' ELSE 'Thấp' END AS metric, count(*)::double precision AS value FROM incidents WHERE $__timeFilter(first_seen) GROUP BY severity ORDER BY value DESC;" }],
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 3 }, { "color": "red", "value": 10 }] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "maxVizHeight": 300, "minVizHeight": 16, "minVizWidth": 8, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }, "showUnfilled": true, "sizing": "auto", "text": { "titleSize": 14, "valueSize": 14 }, "valueMode": "color" }
    },
    {
      "id": 19, "type": "stat", "title": "Thời gian xử lý trung bình", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 34 },
      "datasource": { "type": "postgres", "uid": "bpo-postgres" },
      "targets": [{ "format": "time_series", "rawQuery": true, "refId": "A", "rawSql": "SELECT NOW() AS time, avg(EXTRACT(EPOCH FROM (resolved_at-first_seen)))::double precision AS value FROM incidents WHERE status='resolved' AND resolved_at IS NOT NULL AND $__timeFilter(first_seen);" }],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 300 }, { "color": "red", "value": 900 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    }
  ],
