    },
    {
      "id": 13, "type": "timeseries", "title": "Độ trễ FPT và Viettel", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "bpo-prometheus" },
      "targets": [{ "expr": "bpo_latency_ms", "legendFormat": "{{provider}}", "refId": "A" }],
